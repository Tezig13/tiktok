{
  "_meta": {
    "template": "comment-sans",
    "source": "tips alcool Scrollups format (50k vues) — Comment X sans Y + 5 points numérotés",
    "how_to_use": [
      "1. cp templates/comment-sans.json slides-config.json",
      "2. Remplace tous les [BRACKETS]",
      "3. node generate-slides.js"
    ]
  },
  "defaults": {
    "fontFamily": "Montserrat, sans-serif",
    "color": "#ffffff",
    "align": "center"
  },
  "slides": [
    {
      "imageTheme": "hook_viral_homme",
      "lines": [
        { "text": "Comment [X faire]", "size": 58, "weight": "bold", "y": 1100 },
        { "text": "sans [Y problème]", "size": 58, "weight": "bold", "y": 1180 },
        { "text": "([bénéfice bonus en parenthèse])", "size": 42, "weight": "normal", "y": 1300 }
      ]
    },
    {
      "imageTheme": "gym",
      "lines": [
        { "text": "1. [CONSEIL 1 LIGNE 1]", "size": 50, "weight": "bold", "y": 900 },
        { "text": "[CONSEIL 1 LIGNE 2]", "size": 50, "weight": "bold", "y": 975 },
        { "text": "[détail concret]", "size": 40, "weight": "normal", "y": 1085 }
      ]
    },
    {
      "imageTheme": "nourriture",
      "overlay": 0.3,
      "lines": [
        { "text": "2. [CONSEIL 2]", "size": 52, "weight": "bold", "y": 850 },
        { "text": "[explication]", "size": 42, "weight": "normal", "y": 970 }
      ]
    },
    {
      "imageTheme": "gym",
      "lines": [
        { "text": "3. [CONSEIL 3]", "size": 50, "weight": "bold", "y": 900 },
        { "text": "[explication ligne 1]", "size": 42, "weight": "normal", "y": 1010 },
        { "text": "[explication ligne 2]", "size": 42, "weight": "normal", "y": 1075 }
      ]
    },
    {
      "imagePath": "./app_screenshots/scrollups.jpg",
      "overlay": 0,
      "lines": [
        { "text": "4. utilise ScrollUps", "size": 64, "weight": "bold", "y": 180 },
        { "text": "[explication ScrollUps ligne 1]", "size": 40, "weight": "normal", "y": 290 },
        { "text": "[explication ScrollUps ligne 2]", "size": 40, "weight": "normal", "y": 350 }
      ]
    },
    {
      "imageTheme": "hook_viral_homme",
      "overlay": 0.55,
      "lines": [
        { "text": "5. [CTA / principe final]", "size": 52, "weight": "bold", "y": 900 },
        { "text": "[punchline]", "size": 46, "weight": "normal", "y": 1020 },
        { "text": "[fin]", "size": 46, "weight": "normal", "y": 1090 }
      ]
    }
  ]
}
