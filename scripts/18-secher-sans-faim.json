        {
          "text": "la soif te fait croire que t'as faim.",
          "size": 42,
          "weight": "normal",
          "y": 950
        },
        {
          "text": "toujours.",
          "size": 42,
          "weight": "normal",
          "y": 1009
        }
      ]
    },
    {
